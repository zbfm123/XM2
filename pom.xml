<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>hospital-appointment</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>hospital-appointment</name>
    <description>医院预约挂号系统（秋招项目 2）</description>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <!-- Web + 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 鉴权：JWT 直接复用项目 1 的成熟做法（决策 D-09） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

<!--
          Redis：**已真实使用**（2026-10-07）—— 号源查询缓存（Cache-Aside）。

          用途：ScheduleService.listByDoctor 的查询结果缓存，
                挂号 / 取消 / 超时取消三处失效，缓存故障自动降级为直查数据库。
          见 docs/02-architecture.md 的「关于 Redis」一节。

          ⚠️ 关键边界：**Redis 不参与扣减**。号源扣减走单条原子 UPDATE，
          完全不经过缓存，所以缓存再旧也不可能多卖一个号 ——
          缓存只允许影响「快慢」，不允许影响「对错」。

          历史（保留，因为那次判断本身是对的）：这段注释一度写着
          「依赖在，但当前一处都没用到」「引入一个不用它的依赖是负资产」。
          那时幂等靠唯一索引、防超卖靠原子 UPDATE、限流落库，
          三件本该用 Redis 的事确实都有更可靠的做法 ——
          **「不用它」这个判断没错，错的是「引了却不用」。**
          后来在唯一真正合适的场景（读多写少的号源查询）上把它用起来了。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          ⚠️ T-010 才加进来的依赖。

          为什么不在 T-001 就加：本机 RabbitMQ 当时没装，加了它应用启动时会尝试
          自动配置连接工厂，在没有 broker 的情况下会产生噪音甚至启动失败——
          而 T-001 的目标是"骨架能跑起来"。

          另一层理由更重要，也是本项目的需求 A-07：
          **MQ 不可用时挂号必须仍然成功**。
          所以"先在没有 MQ 的环境下把业务跑通"不是妥协，而是刻意的开发顺序：
          如果一开始就有 MQ，就很难发现自己不知不觉把主流程和 MQ 绑在了一起。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- 持久层 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2 内存库：单元与集成测试不依赖本地 MySQL -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
